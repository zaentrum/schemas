{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaentrum.github.io/schemas/library/source.schema.json",
  "title": "source.json — the master file of a version",
  "description": "Everything known about one master file: identity and fixity, what its name and folder claimed, whether it is an original or already a re-encode, and a complete stream inventory. The untouched ffprobe output is kept verbatim in 'probe' so that nothing the normalised fields miss is ever lost. The master itself is never modified.",
  "type": "object",
  "allOf": [{ "$ref": "defs.schema.json#/$defs/envelope" }],
  "required": ["schema", "id", "rev", "versionId", "workId", "createdAt", "updatedAt", "file", "container", "streams", "fidelity"],
  "unevaluatedProperties": false,
  "properties": {
    "schema": { "const": "zaentrum.library.source/1" },
    "id": true, "rev": true, "createdAt": true, "createdBy": true, "updatedAt": true, "updatedBy": true,
    "versionId": { "$ref": "defs.schema.json#/$defs/uuid" },
    "workId": { "$ref": "defs.schema.json#/$defs/uuid" },

    "file": {
      "type": "object",
      "required": ["path", "name", "sizeBytes", "fixity"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "defs.schema.json#/$defs/relPath", "description": "source/<name>, relative to the version directory." },
        "name": { "type": "string", "description": "Original filename, unchanged." },
        "kind": { "enum": ["stream-container", "disc-image", "transport-stream", "audio-file"] },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "mtime": { "$ref": "defs.schema.json#/$defs/timestamp" },
        "fixity": { "$ref": "defs.schema.json#/$defs/fixity" },
        "origin": {
          "type": "object",
          "description": "Where the file lived before it entered the library. The folder name is often the ONLY record of an edition ('Example Film - Unrated (2015)') or of a series qualifier ('Example Show (US)').",
          "additionalProperties": false,
          "properties": {
            "libraryPath": { "type": "string" },
            "folder": { "type": "string" },
            "migratedAt": { "$ref": "defs.schema.json#/$defs/timestamp" },
            "method": { "enum": ["hardlink", "rename", "copy"] }
          }
        }
      }
    },

    "labels": {
      "type": "object",
      "description": "What the filename and folder CLAIM. Unreliable — a 'Remux' is often a re-encode — but the only quality claim on record, so kept exactly as found.",
      "additionalProperties": false,
      "properties": {
        "quality": { "type": ["string", "null"], "description": "e.g. 'Remux-1080p', 'WEBDL-2160p'." },
        "releaseSource": { "enum": ["remux", "bluray", "webdl", "webrip", "hdtv", "sdtv", "dvd", "telesync", "cam", "unknown", null] },
        "resolution": { "type": ["string", "null"] },
        "proper": { "type": "boolean" },
        "revision": { "type": ["string", "null"], "description": "e.g. 'v2' for a revised release." },
        "edition": { "type": ["string", "null"], "description": "Edition wording found in the name or folder." },
        "folderEdition": { "type": ["string", "null"] }
      }
    },

    "container": {
      "type": "object",
      "required": ["format"],
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string" },
        "durationMs": { "type": ["integer", "null"] },
        "bitrate": { "type": ["integer", "null"] },
        "title": { "type": ["string", "null"], "description": "Container title tag. Frequently the ORIGINAL release name, and the richest surviving record of what the file was before any re-encode." },
        "muxingApp": { "type": ["string", "null"] },
        "writingApp": { "type": ["string", "null"] },
        "creationTime": { "type": ["string", "null"] },
        "tags": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },

    "fidelity": {
      "type": "object",
      "required": ["class"],
      "additionalProperties": false,
      "properties": {
        "class": { "enum": ["original", "derivative", "unknown"] },
        "evidence": { "type": "array", "items": { "$ref": "defs.schema.json#/$defs/evidence" } }
      }
    },

    "streams": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/videoStream" },
          { "$ref": "#/$defs/audioStream" },
          { "$ref": "#/$defs/subtitleStream" },
          { "$ref": "#/$defs/attachmentStream" },
          { "$ref": "#/$defs/dataStream" }
        ]
      }
    },

    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startMs", "endMs"],
        "additionalProperties": false,
        "properties": {
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 0 },
          "title": { "type": ["string", "null"] }
        }
      }
    },

    "segments": {
      "type": "array",
      "description": "Detected intro, recap and credits ranges.",
      "items": {
        "type": "object",
        "required": ["kind", "startMs", "endMs"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["intro", "recap", "credits", "preview", "commercial", "other"] },
          "startMs": { "type": "integer" },
          "endMs": { "type": "integer" },
          "detector": { "type": ["string", "null"] },
          "confidence": { "type": ["number", "null"] },
          "label": { "type": ["string", "null"] }
        }
      }
    },

    "sidecars": {
      "type": "array",
      "description": "Files that sat next to the master and belong to it: external subtitles, NFO text, images.",
      "items": {
        "type": "object",
        "required": ["file", "kind"],
        "additionalProperties": false,
        "properties": {
          "file": { "$ref": "defs.schema.json#/$defs/relPath" },
          "originalName": { "type": "string" },
          "kind": { "enum": ["subtitle", "nfo", "image", "other"] },
          "format": { "type": ["string", "null"] },
          "language": { "oneOf": [{ "$ref": "defs.schema.json#/$defs/language" }, { "type": "null" }] },
          "forced": { "type": "boolean" },
          "hearingImpaired": { "type": "boolean" },
          "sizeBytes": { "type": "integer" },
          "fixity": { "$ref": "defs.schema.json#/$defs/fixity" }
        }
      }
    },

    "subtitleDecisions": {
      "type": "object",
      "description": "Curated subtitle choices a person made (which track is the default). Irreplaceable.",
      "additionalProperties": false,
      "properties": {
        "defaultStreamIndex": { "type": ["integer", "null"] },
        "decidedBy": { "enum": ["human", "rule", "legacy-catalog", null] }
      }
    },

    "probe": {
      "type": "object",
      "description": "The verbatim tool output, retained so that any attribute the normalised fields do not model is still recoverable.",
      "required": ["tool", "at", "raw"],
      "additionalProperties": false,
      "properties": {
        "tool": { "const": "ffprobe" },
        "version": { "type": ["string", "null"] },
        "at": { "$ref": "defs.schema.json#/$defs/timestamp" },
        "raw": { "type": ["object", "null"] },
        "note": { "type": ["string", "null"] }
      }
    }
  },

  "$defs": {
    "dispositions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "type": "boolean" },
        "forced": { "type": "boolean" },
        "original": { "type": "boolean" },
        "dub": { "type": "boolean" },
        "commentary": { "type": "boolean" },
        "hearingImpaired": { "type": "boolean" },
        "visualImpaired": { "type": "boolean", "description": "Audio description track." },
        "attachedPic": { "type": "boolean" }
      }
    },
    "base": {
      "type": "object",
      "required": ["index", "type"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "type": true,
        "codec": { "type": ["string", "null"] },
        "language": { "oneOf": [{ "$ref": "defs.schema.json#/$defs/language" }, { "type": "null" }] },
        "languageRaw": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "dispositions": { "$ref": "#/$defs/dispositions" }
      }
    },
    "videoStream": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "video" },
        "profile": { "type": ["string", "null"] },
        "level": { "type": ["number", "null"] },
        "bitDepth": { "type": ["integer", "null"] },
        "pixelFormat": { "type": ["string", "null"] },
        "width": { "type": ["integer", "null"] },
        "height": { "type": ["integer", "null"] },
        "sampleAspectRatio": { "type": ["string", "null"] },
        "displayAspectRatio": { "type": ["string", "null"] },
        "frameRate": { "type": ["string", "null"] },
        "fieldOrder": { "type": ["string", "null"] },
        "bitrate": { "type": ["integer", "null"] },
        "colour": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primaries": { "type": ["string", "null"] },
            "transfer": { "type": ["string", "null"] },
            "matrix": { "type": ["string", "null"] },
            "range": { "type": ["string", "null"] }
          }
        },
        "hdr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": { "enum": ["sdr", "hdr10", "hdr10plus", "hlg", "dolby-vision"] },
            "masteringDisplay": { "type": ["object", "null"] },
            "contentLightLevel": { "type": ["object", "null"] },
            "dolbyVision": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "profile": { "type": "integer" },
                "level": { "type": "integer" },
                "rpuPresent": { "type": "boolean" },
                "elPresent": { "type": "boolean" },
                "blPresent": { "type": "boolean" },
                "blCompatibilityId": { "type": "integer" }
              }
            }
          }
        },
        "stereo3d": { "type": ["string", "null"] },
        "encoder": { "type": ["string", "null"], "description": "Encoder tag, e.g. 'Lavc hevc_nvenc' — the plainest evidence of a re-encode." }
      }
    },
    "audioStream": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "audio" },
        "profile": { "type": ["string", "null"], "description": "Distinguishes e.g. DTS-HD MA from its core, and 'Dolby Digital Plus + Dolby Atmos'." },
        "channels": { "type": "integer", "minimum": 1 },
        "channelLayout": { "type": ["string", "null"], "description": "'stereo', '5.1', '5.1(side)', '7.1'. Absent in some files even when channels = 6." },
        "sampleRate": { "type": ["integer", "null"] },
        "bitDepth": { "type": ["integer", "null"] },
        "bitrate": { "type": ["integer", "null"] },
        "lossless": { "type": ["boolean", "null"] },
        "objectAudio": { "enum": ["atmos", "dts-x", "none", "unknown"] },
        "titleClaim": {
          "type": ["object", "null"],
          "description": "What the track title claims, parsed. When it disagrees with the actual codec or channel count, the file was re-encoded and the title is the only record of the original.",
          "additionalProperties": false,
          "properties": {
            "codec": { "type": ["string", "null"] },
            "channels": { "type": ["string", "null"] },
            "contradictsActual": { "type": "boolean" }
          }
        },
        "encoder": { "type": ["string", "null"] }
      },
      "required": ["channels"]
    },
    "subtitleStream": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "subtitle" },
        "form": { "enum": ["text", "image"], "description": "Image subtitles (PGS, VobSub) cannot be converted to text without OCR." },
        "styled": { "type": "boolean", "description": "ASS/SSA with positioning and typesetting that plain WebVTT loses." },
        "variant": { "type": ["string", "null"], "description": "Region or script, e.g. 'Latin American', 'Simplified'." }
      }
    },
    "attachmentStream": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "attachment" },
        "filename": { "type": ["string", "null"] },
        "mimetype": { "type": ["string", "null"] },
        "role": { "enum": ["font", "cover", "other"], "description": "Fonts are required to render styled subtitles." }
      }
    },
    "dataStream": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "data" }
      }
    }
  }
}
