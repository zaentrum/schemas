{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaentrum.github.io/schemas/library/package.schema.json",
  "title": "package.json — a derived rendition of a version",
  "description": "Describes how a playable rendition was made from a source and, above all, what it LOST relative to that source. A package is disposable: it can always be rebuilt from its source, and a source must never be deleted on the strength of a package existing. The playback manifest the streaming service reads (manifest.json) sits beside this file unchanged.",
  "type": "object",
  "allOf": [{ "$ref": "defs.schema.json#/$defs/envelope" }],
  "required": ["schema", "id", "rev", "versionId", "workId", "sourceId", "createdAt", "updatedAt", "state", "manifest", "renditions", "fidelity"],
  "unevaluatedProperties": false,
  "properties": {
    "schema": { "const": "zaentrum.library.package/1" },
    "id": true, "rev": true, "createdAt": true, "createdBy": true, "updatedAt": true, "updatedBy": true,
    "versionId": { "$ref": "defs.schema.json#/$defs/uuid" },
    "workId": { "$ref": "defs.schema.json#/$defs/uuid" },
    "sourceId": { "$ref": "defs.schema.json#/$defs/uuid" },
    "state": { "enum": ["complete", "failed", "stale", "building"] },

    "manifest": {
      "type": "object",
      "required": ["file", "version", "sha256"],
      "additionalProperties": false,
      "properties": {
        "file": { "$ref": "defs.schema.json#/$defs/relPath" },
        "version": { "type": "integer" },
        "sha256": { "$ref": "defs.schema.json#/$defs/sha256" }
      }
    },

    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packager": { "type": ["string", "null"] },
        "packagedAt": { "oneOf": [{ "$ref": "defs.schema.json#/$defs/timestamp" }, { "type": "null" }] },
        "video": { "type": ["string", "null"], "description": "e.g. 'copy', 'hevc main 1080p re-encode'." },
        "audio": { "type": ["string", "null"], "description": "e.g. 'aac-lc 2ch 192k'." },
        "subtitles": { "type": ["string", "null"], "description": "e.g. 'text -> webvtt, image -> sidecar'." },
        "segmentSeconds": { "type": ["integer", "null"] }
      }
    },

    "renditions": {
      "type": "object",
      "required": ["video", "audio", "subtitles"],
      "additionalProperties": false,
      "properties": {
        "video": {
          "type": "array",
          "description": "More than one entry is a quality ladder.",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "codec": { "type": ["string", "null"] },
              "width": { "type": ["integer", "null"] },
              "height": { "type": ["integer", "null"] },
              "bitrate": { "type": ["integer", "null"] },
              "dynamicRange": { "enum": ["sdr", "hdr10", "hdr10plus", "hlg", "dolby-vision", "unknown"] },
              "sourceStreamIndex": { "type": ["integer", "null"] }
            }
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "channels"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "codec": { "type": ["string", "null"] },
              "channels": { "type": "integer" },
              "bitrate": { "type": ["integer", "null"] },
              "language": { "oneOf": [{ "$ref": "defs.schema.json#/$defs/language" }, { "type": "null" }] },
              "label": { "type": ["string", "null"] },
              "default": { "type": "boolean" },
              "sourceStreamIndex": { "type": ["integer", "null"] },
              "sourceChannels": { "type": ["integer", "null"], "description": "Channels in the source track it was made from." }
            }
          }
        },
        "subtitles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "format": { "type": ["string", "null"] },
              "language": { "oneOf": [{ "$ref": "defs.schema.json#/$defs/language" }, { "type": "null" }] },
              "forced": { "type": "boolean" },
              "default": { "type": "boolean" },
              "sourceStreamIndex": { "type": ["integer", "null"] }
            }
          }
        }
      }
    },

    "fidelity": {
      "type": "object",
      "required": ["lossless", "losses"],
      "additionalProperties": false,
      "properties": {
        "lossless": { "type": "boolean" },
        "losses": {
          "type": "array",
          "description": "Every way this rendition is poorer than its source. Empty only when lossless is true.",
          "items": {
            "type": "object",
            "required": ["kind", "detail"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": ["audio-downmix", "audio-codec", "audio-dropped", "video-resolution", "video-bitdepth", "dynamic-range", "dolby-vision", "stereo3d", "subtitle-dropped", "subtitle-styling", "attachments-dropped", "chapters-dropped", "other"]
              },
              "detail": { "type": "string" },
              "sourceStreamIndex": { "type": ["integer", "null"] }
            }
          }
        },
        "droppedSourceStreams": { "type": "array", "items": { "type": "integer" } }
      }
    }
  }
}
